{
  "name": "arrohan-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Arrohan Living ERP — end-to-end automated workflow from enquiry to gate pass",
  "type": "commonjs",
  "scripts": {
    "setup": "npm install && cd client && npm install && cd .. && npm run build",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "seed": "node server/seed.js",
    "reset-db": "node server/reset.js",
    "smoke": "node scripts/smoke.js",
    "reset-password": "node scripts/reset-password.js",
    "demo-data": "node scripts/demo-data.js",
    "turso:setup": "node scripts/turso-setup.js"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
